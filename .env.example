# Copie para ".env" e preencha. Gere a chave com:  python -c "import secrets;print(secrets.token_hex(32))"
DOMINIO=comandas.seudominio.com.br
COMANDAFACIL_SECRET_KEY=troque-por-uma-chave-aleatoria-longa

# Endereço público do sistema (obrigatório online: vai nos links de e-mail e no retorno do Google).
# Em rede local deixe sem preencher (usa o endereço do navegador).
# COMANDAFACIL_PUBLIC_URL=https://comandas.seudominio.com.br

# Login com Google (opcional) — veja "Login com Google" no README
COMANDAFACIL_GOOGLE_CLIENT_ID=
COMANDAFACIL_GOOGLE_CLIENT_SECRET=

# Recuperação de senha por e-mail (opcional) — veja "Recuperação de senha" no README
COMANDAFACIL_SMTP_HOST=
COMANDAFACIL_SMTP_PORT=587
COMANDAFACIL_SMTP_USER=
COMANDAFACIL_SMTP_PASSWORD=
COMANDAFACIL_SMTP_FROM=
COMANDAFACIL_SMTP_SECURITY=starttls
